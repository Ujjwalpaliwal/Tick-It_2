# =========================================================================
# TICK-IT OS — CENTRALIZED ENVIRONMENT & STARTUP URLS CONFIGURATION
# =========================================================================
# This file provides a consolidated overview of all URLs, ports, and configuration 
# variables used to run the Tick-It OS backend and frontend applications locally.
# Copy relevant blocks to their respective directories ('server/.env' and 'my-app/.env') 
# as required by the setup sequence.
# =========================================================================

# -------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB)
# -------------------------------------------------------------------------
# Your local or remote MongoDB Connection String.
# - If MONGO_URI is omitted or database is offline, the backend server will automatically 
#   fall back to a temporary 'mongodb-memory-server' (In-Memory Database) for a zero-config start.
MONGO_URI=mongodb://localhost:27017/eigenmatrix

# -------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Express / Node.js)
# -------------------------------------------------------------------------
# The port and URL environment parameters for running the server.
PORT=5000
BACKEND_LOCAL_URL=http://localhost:5000
BACKEND_API_URL=http://localhost:5000/api
BACKEND_HEALTH_CHECK=http://localhost:5000/

# Development mode settings
NODE_ENV=development
JWT_SECRET=super_secret_dev_key_123_abc_xyz

# -------------------------------------------------------------------------
# 3. FRONTEND MOBILE & WEB APP CONFIGURATION (React Native / Expo)
# -------------------------------------------------------------------------
# Expo's development server (Metro Bundler) default ports and entry URLs.
# - Web Application URL: Open this URL in your web browser to run the web-compatible client.
# - Metro Bundler URL: Metro packages and compiles JS code for devices and emulators.
FRONTEND_PORT=8081
FRONTEND_WEB_URL=http://localhost:8081
FRONTEND_METRO_URL=http://localhost:8081

# Frontend Environment Variable targeting the local backend API:
# - Leave blank to let the app dynamically resolve your local development machine IP 
#   for Android Emulators / iOS Simulators / Expo Go on physical phones.
# - Set explicitly for testing with tunnels (e.g. ngrok) or for production builds.
EXPO_PUBLIC_API_URL=http://localhost:5000/api
