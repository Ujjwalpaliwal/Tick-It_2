# Backend Server API URL configuration for mobile app
# Replace with your tunnel URL (e.g. ngrok) when using Expo Tunnel:
# EXPO_PUBLIC_API_URL=https://your-backend-tunnel.ngrok-free.app/api

# For local development without tunnel, the app will automatically
# resolve your local host machine IP dynamically, so you can leave this blank.
# EXPO_PUBLIC_API_URL=https://tick-it-backend-7x4p.onrender.com/api
